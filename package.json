{
  "name": "slauthjs",
  "version": "2.0.0",
  "description": "Open-source auth you own: email codes, passkeys, \"Sign in with GitHub/Google\", passwords, two-factor, sessions, organizations and JWTs. Your database, zero dependencies. Runs on Workers, Bun, Deno and Node.",
  "license": "MIT",
  "type": "module",
  "main": "./src/index.js",
  "types": "./src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "default": "./src/index.js"
    },
    "./client": {
      "types": "./src/client.d.ts",
      "default": "./src/client.js"
    },
    "./providers": {
      "types": "./src/providers.d.ts",
      "default": "./src/providers.js"
    },
    "./challenge": {
      "types": "./src/challenge.d.ts",
      "default": "./src/challenge.js"
    },
    "./element": {
      "types": "./src/element.d.ts",
      "default": "./src/element.js"
    },
    "./account": {
      "types": "./src/account-element.d.ts",
      "default": "./src/account-element.js"
    },
    "./node": {
      "types": "./src/node.d.ts",
      "default": "./src/node.js"
    },
    "./stores/memory": {
      "types": "./src/stores/memory.d.ts",
      "default": "./src/stores/memory.js"
    },
    "./stores/d1": {
      "types": "./src/stores/d1.d.ts",
      "default": "./src/stores/d1.js"
    },
    "./stores/kv": {
      "types": "./src/stores/kv.d.ts",
      "default": "./src/stores/kv.js"
    },
    "./stores/sqlite": {
      "types": "./src/stores/sqlite.d.ts",
      "default": "./src/stores/sqlite.js"
    },
    "./stores/postgres": {
      "types": "./src/stores/postgres.d.ts",
      "default": "./src/stores/postgres.js"
    },
    "./stores/libsql": {
      "types": "./src/stores/libsql.d.ts",
      "default": "./src/stores/libsql.js"
    },
    "./email/console": {
      "types": "./src/email/console.d.ts",
      "default": "./src/email/console.js"
    },
    "./email/resend": {
      "types": "./src/email/resend.d.ts",
      "default": "./src/email/resend.js"
    },
    "./email/cloudflare": {
      "types": "./src/email/cloudflare.d.ts",
      "default": "./src/email/cloudflare.js"
    }
  },
  "files": [
    "src",
    "CHANGELOG.md",
    "!src/**/*.test.js"
  ],
  "sideEffects": [
    "./src/element.js",
    "./src/account-element.js"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json",
    "prepublishOnly": "vitest run && tsc -p tsconfig.json",
    "smoke": "node test/smoke.mjs"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.15",
    "@libsql/client": "^0.18.0",
    "@types/node": "^22.20.5",
    "typescript": "^5.9.3",
    "vitest": "^5.0.3"
  },
  "keywords": [
    "auth",
    "authentication",
    "oauth",
    "oidc",
    "sign-in-with-github",
    "passkeys",
    "webauthn",
    "two-factor",
    "totp",
    "magic-link",
    "sessions",
    "organizations",
    "jwt",
    "nextauth-alternative",
    "clerk-alternative",
    "cloudflare-workers",
    "d1",
    "postgres",
    "turso",
    "bun",
    "deno"
  ],
  "homepage": "https://slauth.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/silicondaydream/slauth.git"
  },
  "packageManager": "pnpm@10.28.0",
  "publishConfig": {
    "access": "public"
  }
}
