---
/**
 * The mascot, drawn by hand. mood: "happy" | "sleepy" | "wink"; hang adds the branch and arms.
 *
 * The outer outline follows the theme (--sloth-line): dark ink on light pages, a cream
 * sticker edge on dark ones, so the sloth never melts into the background. Details on
 * the cream face (eyes, nose, mouth) stay dark either way.
 */
interface Props {
  mood?: 'happy' | 'sleepy' | 'wink'
  hang?: boolean
  size?: number | string
  class?: string
  title?: string
}
const { mood = 'happy', hang = false, size = 200, class: cls, title } = Astro.props
const ink = '#2b2118'
---
<svg
  class:list={['sloth', cls, { hanging: hang }]}
  width={size}
  height={size}
  viewBox={hang ? '0 0 220 230' : '30 45 160 160'}
  role={title ? 'img' : undefined}
  aria-hidden={title ? undefined : 'true'}
  aria-label={title}
  xmlns="http://www.w3.org/2000/svg"
>
  {hang && (
    <g>
      <path class="line" d="M6 34 Q110 18 214 30" stroke-width="16" stroke-linecap="round" fill="none" />
      <path d="M6 34 Q110 18 214 30" stroke="#8a5a32" stroke-width="10" stroke-linecap="round" fill="none" />
      <g class="leaves">
        <ellipse class="line" cx="40" cy="24" rx="14" ry="7" fill="#7aa340" stroke-width="3" transform="rotate(-25 40 24)" />
        <ellipse class="line" cx="176" cy="20" rx="13" ry="6.5" fill="#7aa340" stroke-width="3" transform="rotate(20 176 20)" />
        <ellipse class="line" cx="192" cy="40" rx="11" ry="5.5" fill="#9cc25e" stroke-width="3" transform="rotate(35 192 40)" />
      </g>
    </g>
  )}
  <g class="body">
    {hang && (
      <g>
        <path class="line" d="M70 120 Q60 70 76 30" stroke-width="26" stroke-linecap="round" fill="none" />
        <path d="M70 120 Q60 70 76 30" stroke="#a87b55" stroke-width="20" stroke-linecap="round" fill="none" />
        <path class="line" d="M150 120 Q160 70 144 30" stroke-width="26" stroke-linecap="round" fill="none" />
        <path d="M150 120 Q160 70 144 30" stroke="#a87b55" stroke-width="20" stroke-linecap="round" fill="none" />
        <path class="line" d="M68 30 q-4 -12 4 -14 M76 30 q0 -13 8 -13 M84 32 q4 -12 10 -9" stroke-width="3.5" stroke-linecap="round" fill="none" />
        <path class="line" d="M152 30 q4 -12 -4 -14 M144 30 q0 -13 -8 -13 M136 32 q-4 -12 -10 -9" stroke-width="3.5" stroke-linecap="round" fill="none" />
      </g>
    )}
    <g transform={hang ? 'translate(0 25)' : undefined}>
      <ellipse class="line" cx="110" cy="120" rx="66" ry="62" fill="#a87b55" stroke-width="4" />
      <path d="M60 92 q10 -16 22 -10 M138 82 q12 -6 22 10 M96 64 q14 -8 28 0" stroke="#8a6142" stroke-width="4" stroke-linecap="round" fill="none" />
      <ellipse cx="110" cy="130" rx="50" ry="42" fill="#f3e2c4" stroke={ink} stroke-width="3.5" />
      <ellipse cx="86" cy="122" rx="17" ry="10" fill="#6b4428" transform="rotate(-22 86 122)" />
      <ellipse cx="134" cy="122" rx="17" ry="10" fill="#6b4428" transform="rotate(22 134 122)" />
      {mood === 'sleepy' ? (
        <g stroke="#fdf6ec" stroke-width="3.5" stroke-linecap="round" fill="none">
          <path d="M80 122 q6 5 12 0" />
          <path d="M128 122 q6 5 12 0" />
        </g>
      ) : (
        <g class="eyes">
          <circle cx="88" cy="121" r="5.5" fill="#fdf6ec" />
          <circle cx="89" cy="121" r="3.4" fill={ink} />
          {mood === 'wink' ? (
            <path d="M127 122 q7 -6 14 0" stroke="#fdf6ec" stroke-width="3.5" stroke-linecap="round" fill="none" />
          ) : (
            <g>
              <circle cx="132" cy="121" r="5.5" fill="#fdf6ec" />
              <circle cx="131" cy="121" r="3.4" fill={ink} />
            </g>
          )}
        </g>
      )}
      <ellipse cx="110" cy="138" rx="9" ry="6.5" fill={ink} />
      <path d="M98 151 q12 10 24 0" stroke={ink} stroke-width="3.5" stroke-linecap="round" fill="none" />
      <circle cx="74" cy="144" r="7" fill="#f7b2c6" opacity="0.85" />
      <circle cx="146" cy="144" r="7" fill="#f7b2c6" opacity="0.85" />
      {mood === 'sleepy' && (
        <g class="zzz" font-family="ui-sans-serif, system-ui" font-weight="800">
          <text x="168" y="74" font-size="20">z</text>
          <text x="182" y="56" font-size="15">z</text>
        </g>
      )}
    </g>
  </g>
</svg>

<style>
  .sloth .line { stroke: var(--sloth-line, #2b2118); }
  .sloth .zzz { fill: var(--sloth-line, #2b2118); }
</style>
