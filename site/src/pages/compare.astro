---
import Site from '../layouts/Site.astro'
import Sloth from '../components/Sloth.astro'

const cols = ['Hard-coded password', 'slauth', 'Auth.js (NextAuth)', 'Clerk']
type Cell = [mark: '✅' | '⚠️' | '❌' | '', text: string]
const rows: { label: string; cells: Cell[] }[] = [
  { label: 'Time to first sign-in', cells: [['✅', '2 minutes'], ['✅', '~5 minutes'], ['⚠️', 'An afternoon of providers and adapters'], ['✅', '~10 minutes']] },
  { label: 'Separate accounts per person', cells: [['❌', 'One password for everyone'], ['✅', 'Yes'], ['✅', 'Yes'], ['✅', 'Yes']] },
  { label: 'Email codes & magic links', cells: [['❌', 'No'], ['✅', 'Built in'], ['⚠️', 'Magic links, with an email adapter'], ['✅', 'Yes']] },
  { label: 'Passkeys', cells: [['❌', 'No'], ['✅', 'Built in'], ['⚠️', 'Experimental'], ['✅', 'Yes']] },
  { label: '"Sign in with Google/GitHub/…"', cells: [['❌', 'No'], ['✅', '5 built in, plus any OIDC / OAuth 2'], ['✅', 'Dozens of providers'], ['✅', 'Lots']] },
  { label: 'Passwords', cells: [['⚠️', 'Exactly one'], ['✅', 'Optional, email-verified'], ['⚠️', 'Credentials provider, DIY hashing'], ['✅', 'Yes']] },
  { label: 'Two-factor (authenticator app)', cells: [['❌', 'No'], ['✅', 'With recovery codes'], ['❌', 'Build it yourself'], ['✅', 'Yes']] },
  { label: 'Session & device management', cells: [['❌', 'No'], ['✅', 'List, revoke, sign out others'], ['⚠️', 'Build it yourself'], ['✅', 'Yes']] },
  { label: 'Orgs, roles & invitations', cells: [['❌', 'No'], ['✅', 'Built in'], ['❌', 'Build it yourself'], ['✅', 'Yes']] },
  { label: 'Admin API (ban, impersonate…)', cells: [['❌', 'No'], ['✅', 'Server-side API; bring your own UI'], ['❌', 'Build it yourself'], ['✅', 'API + hosted dashboard']] },
  { label: 'JWTs for other services', cells: [['❌', 'No'], ['✅', 'ES256 + JWKS'], ['✅', 'JWT sessions'], ['✅', 'Yes']] },
  { label: 'Drop-in UI', cells: [['❌', 'No'], ['✅', 'Sign-in box + account page (web components)'], ['⚠️', 'A basic sign-in page'], ['✅', 'Polished React components']] },
  { label: 'SAML, SCIM, enterprise SSO', cells: [['❌', 'No'], ['❌', 'No'], ['⚠️', 'Via an identity provider'], ['✅', 'Yes (paid)']] },
  { label: 'Where your users live', cells: [['', 'An env var'], ['✅', 'Your database'], ['✅', 'Your database'], ['⚠️', 'Their servers']] },
  { label: 'Cost', cells: [['✅', 'Free'], ['✅', 'Free (MIT)'], ['✅', 'Free (open source)'], ['⚠️', 'Free tier, then per user']] },
  { label: 'Runs on Workers, Bun, Deno, Node', cells: [['✅', 'Anything'], ['✅', 'Anything with Request/Response'], ['⚠️', 'Best with Next.js; other frameworks vary'], ['⚠️', 'Through their SDKs']] },
  { label: 'Dependencies', cells: [['✅', 'None'], ['✅', 'None'], ['⚠️', 'Several'], ['⚠️', 'Their SDK']] },
  { label: 'Survives a security review', cells: [['❌', 'Please no'], ['⚠️', 'Small, readable, well tested; no audit yet'], ['✅', 'Widely used'], ['✅', 'That’s their job']] },
  { label: 'Fun', cells: [['⚠️', 'Until it leaks'], ['✅', 'There is a sloth'], ['⚠️', 'Lots of config'], ['⚠️', 'Polished, corporate']] },
]
---
<Site title="Compare · slauth" description="An honest comparison of slauth with a hard-coded password, Auth.js (NextAuth) and Clerk.">
  <section class="block">
    <div class="wrap">
      <div class="head">
        <div>
          <span class="sticker">honest edition</span>
          <h1>How slauth compares</h1>
          <p class="lede">slauth starts where "I put a password in an env var" ends, and goes most of the way to "I signed up for an auth company", without leaving your database. Here's where it shines and where it doesn't.</p>
        </div>
        <Sloth mood="wink" size={150} />
      </div>

      <div class="table-wrap card">
        <table>
          <thead>
            <tr>
              <th scope="col"><span class="sr">Feature</span></th>
              {cols.map((c) => <th scope="col" class={c === 'slauth' ? 'us' : undefined}>{c}</th>)}
            </tr>
          </thead>
          <tbody>
            {rows.map((r) => (
              <tr>
                <th scope="row">{r.label}</th>
                {r.cells.map(([mark, text], i) => (
                  <td class={cols[i] === 'slauth' ? 'us' : undefined}>
                    {mark && <span class="mark" aria-hidden="true">{mark}</span>} {text}
                  </td>
                ))}
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="aside-note">Comparisons as we understand them in late 2026. Other tools change; check their docs before deciding. Corrections are welcome on GitHub.</p>

      <div class="grid three picks">
        <div class="card"><h3>Pick slauth if…</h3><p class="muted">you want sign-in done today, users in your own database, and providers, two-factor and teams on hand for when the project grows, on any runtime.</p></div>
        <div class="card"><h3>Pick Auth.js if…</h3><p class="muted">you're on Next.js and need one of the dozens of providers slauth doesn't ship, and don't mind more configuration.</p></div>
        <div class="card"><h3>Pick Clerk if…</h3><p class="muted">you need SAML, a hosted admin dashboard and compliance paperwork, and would rather pay than run it.</p></div>
      </div>
    </div>
  </section>
</Site>

<style>
  .head { display: flex; flex-wrap: wrap; gap: 24px; align-items: center; justify-content: space-between; margin-bottom: 32px; }
  .lede { font-size: 19px; color: var(--muted); max-width: 640px; }
  .table-wrap { padding: 0; overflow-x: auto; }
  table { width: 100%; border-collapse: collapse; min-width: 760px; font-size: 15px; }
  th, td { text-align: left; padding: 12px 14px; border-bottom: 2px dashed color-mix(in srgb, var(--ink) 18%, transparent); vertical-align: top; }
  thead th { font-size: 15px; background: var(--bg-2); border-bottom: var(--line); }
  tbody th { font-weight: 700; width: 22%; position: sticky; left: 0; background: var(--card); z-index: 1; }
  thead th:first-child { position: sticky; left: 0; z-index: 2; }
  tr:last-child th, tr:last-child td { border-bottom: 0; }
  .us { background: color-mix(in srgb, var(--accent) 22%, transparent); font-weight: 600; }
  thead .us { background: var(--accent); color: var(--accent-ink); }
  .mark { margin-right: 4px; }
  .sr { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); }
  .picks { margin-top: 32px; }
  .picks p { margin: 0; }
</style>
