---
import Site from '../layouts/Site.astro'
import Sloth from '../components/Sloth.astro'

const plans = [
  { name: 'Hobby', price: '$0', note: 'forever', items: ['Unlimited users', 'Email codes, passkeys, providers, 2FA and orgs', 'Every store and framework', 'A sloth'], cta: 'Start free' },
  { name: 'Pro', price: '$0', note: 'also forever', items: ['Everything in Hobby', 'The same code, but you feel more professional', 'Priority sloth (it is still slow)'], cta: 'Start equally free', featured: true },
  { name: 'Enterprise', price: '$0', note: 'and a polite "no"', items: ['Everything in Pro', 'No SAML, no SCIM, no SLA', 'A list of companies who do that'], cta: 'Read the comparison', href: '/compare' },
]
---
<Site title="Pricing · slauth" description="slauth is free and MIT licensed. Here is what you actually pay for: your email provider and your database, usually on free tiers.">
  <section class="block">
    <div class="wrap">
      <div class="head">
        <Sloth mood="happy" size={130} />
        <div>
          <h1>Pricing</h1>
          <p class="lede">$0. Forever. The sloth doesn't do invoices.</p>
        </div>
      </div>

      <div class="grid three">
        {plans.map((p) => (
          <div class:list={['card', 'plan', { featured: p.featured }]}>
            {p.featured && <span class="sticker pink badge">most popular*</span>}
            <h2>{p.name}</h2>
            <p class="price"><strong>{p.price}</strong> <span class="muted">{p.note}</span></p>
            <ul>{p.items.map((i) => <li>{i}</li>)}</ul>
            <a class:list={['btn', { primary: p.featured }]} href={p.href ?? '/docs/quickstart/'}>{p.cta}</a>
          </div>
        ))}
      </div>
      <p class="aside-note">* All three plans are the same plan.</p>

      <div class="card fine">
        <h2>What you actually pay for</h2>
        <p class="muted">slauth is MIT-licensed code you run yourself. The only bills are for the things around it, and for a side project they're usually free tiers:</p>
        <ul>
          <li><strong>Sending emails</strong>: Resend, Cloudflare Email Service, or anything you plug in. Passkey sign-ins send no email at all.</li>
          <li><strong>Your database</strong>: D1, SQLite, KV. slauth stores a few small rows per person.</li>
          <li><strong>Hosting</strong>: wherever your app already runs.</li>
        </ul>
        <p class="muted">If slauth saves you an afternoon, a GitHub star makes the sloth's day.</p>
        <a class="btn" href="https://github.com/silicondaydream/slauth">⭐ Star on GitHub</a>
      </div>
    </div>
  </section>
</Site>

<style>
  .head { display: flex; flex-wrap: wrap; gap: 24px; align-items: center; margin-bottom: 36px; }
  .lede { font-size: 22px; font-weight: 700; margin: 0; }
  .plan { position: relative; display: flex; flex-direction: column; gap: 6px; }
  .plan.featured { background: color-mix(in srgb, var(--accent) 18%, var(--card)); transform: rotate(-0.6deg); }
  .plan h2 { font-size: 28px; margin: 0; }
  .price strong { font-size: 44px; letter-spacing: -0.03em; }
  .plan ul { padding-left: 20px; margin: 4px 0 18px; flex: 1; }
  .plan .btn { justify-content: center; }
  .badge { position: absolute; top: -14px; right: 16px; }
  .fine { margin-top: 40px; }
  .fine ul { padding-left: 20px; }
</style>
