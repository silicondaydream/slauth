---
import Site from '../layouts/Site.astro'
import Sloth from '../components/Sloth.astro'
---
<Site title="Lost · slauth" description="This page doesn't exist." noindex>
  <section class="block">
    <div class="wrap lost">
      <Sloth mood="sleepy" size={180} />
      <h1>404</h1>
      <p class="muted">The sloth looked everywhere for this page. Very slowly. It isn't here.</p>
      <div class="actions">
        <a class="btn primary" href="/">Home</a>
        <a class="btn" href="/docs/">Docs</a>
      </div>
    </div>
  </section>
</Site>

<style>
  .lost { display: grid; justify-items: center; text-align: center; gap: 8px; }
  .actions { display: flex; gap: 12px; margin-top: 12px; }
</style>
